<?xml version='1.0' encoding='utf-8'?>
<XDFFORMAT version="1.80">
  <XDFHEADER>
    <flags>0x1</flags>
    <deftitle>AL5 15184109 / 15183960 - iMob Racing Structural TCC and WOT v0.5</deftitle>
    <description>For 57,304-byte AL5 calibration-segment BINs read from TCM address 0x08000-0x15FD7. Uses BASEOFFSET 0x8000 subtract mode so XDF addresses remain native TCM addresses. Core items are marker-differential verified, exact static-chain mapped, or direct-read/stock-fingerprint mapped as described per item.</description>
    <BASEOFFSET offset="32768" subtract="1" />
    <DEFAULTS datasizeinbits="8" sigdigits="3" outputtype="1" signed="0" lsbfirst="0" float="0" />
    <REGION type="0xFFFFFFFF" startaddress="0x0" size="0xDFD8" regioncolor="0x0" regionflags="0x0" name="AL5 Calibration Segment" desc="TCM 0x08000-0x15FD7, 57,304 bytes" />
    <CATEGORY index="0x0" name="Identity / Warnings" />
    <CATEGORY index="0x1" name="Gear Ratios" />
    <CATEGORY index="0x2" name="Part Throttle Shifts A-D" />
    <CATEGORY index="0x3" name="WOT Shift RPM" />
    <CATEGORY index="0x4" name="TAP / Clutch Pressure" />
    <CATEGORY index="0x5" name="TAV / Off-Going" />
    <CATEGORY index="0x6" name="Base Shift Timing" />
    <CATEGORY index="0x7" name="Torque Control" />
    <CATEGORY index="0x8" name="TCC" />
    <CATEGORY index="0x9" name="Research / Raw" />
    <CATEGORY index="0xA" name="Shift Timing - Throttle Adjust" />
  </XDFHEADER>
  <XDFCONSTANT uniqueid="0x2000">
    <title>READ ME - AL5 segment/XDF usage</title>
    <description>For 57,304-byte calibration segments only. Offline inspection and development. Native CRC16 and BE16 compensation are implemented in Tools/AL5/checksum.py and reproduce stock/PPEI fields; additional native edited-segment validation is pending. The AL5 write protocol is unresolved and live writing is disabled. No edited BIN is flash-ready. New TCC/WOT entries use structural confidence, not marker differentials. The user has no FlashScan.</description>
    <CATEGORYMEM index="0" category="1" />
    <EMBEDDEDDATA mmedelementsizebits="8" mmedmajorstridebits="0" mmedminorstridebits="0" />
    <datatype>0</datatype>
    <unittype>0</unittype>
    <DALINK index="0" />
    <MATH equation="X">
      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
  <XDFCONSTANT uniqueid="0x2001">
    <title>Transmission Calibration ID (15183960 expected)</title>
    <description>Verified live and offline. Expected decimal value 15183960 / raw 00 E7 B0 58.</description>
    <CATEGORYMEM index="0" category="1" />
    <EMBEDDEDDATA mmedaddress="0x8024" mmedelementsizebits="32" mmedmajorstridebits="0" mmedminorstridebits="0" />
    <decimalpl>0</decimalpl>
    <rangelow>0</rangelow>
    <rangehigh>4294967295</rangehigh>
