  "observations": [
    {
      "id": "O1",
      "claim": "Within dispatcher 0xBCE60, state 1 at A5+0x2D1D takes 0xBCE8A and uniquely among its four state branches calls 0xC2FF8 at 0xBCE90. State 0/2 do not call that extra routine; state 3 follows a smaller branch.",
      "windows": [
        "state1_only_extra_dispatch"
      ]
    },
    {
      "id": "O2",
      "claim": "The direct call chain is 0xC2FF8 -> 0xC58F8 (callsite 0xC305E) -> 0xC58E4 (0xC58F8) -> 0xC5674 (0xC58F0) -> 0x83AF4 (0xC5674).",
      "windows": [
        "state1_control_entry",
        "control_bridge_1",
        "control_bridge_2",
        "control_bridge_3"
      ]
    },
    {
      "id": "O3",
      "claim": "0x83AF4 uses A5+0x2D1C==4 to reset A5+0x2D30 to 0 at 0x83B5C. On state0 of that sub-state, it reads pointer A5+0x257C at 0x83BBE, calls interpolation helper0x3DDB8, adds A5+0x27FC at 0x83C68..0x83C70 with signed saturation, and stores the resulting value to A5+0x27DA at 0x83C98.",
      "windows": [
        "desired_shift_time_consumer"
      ]
    },
    {
      "id": "O4",
      "claim": "0x52DCC..0x52DF4 loads A5+0x27FC from BE16 base0xDC68 indexed by signed byte A5+0x2DA7*2; it sets A5+0x257C to table header0xE248 plus that index*0x24. The index-zero calibration is the retained mapped D5080/D5100 pair.",
      "windows": [
        "D5080_D5100_producer"
      ]
    },
    {
      "id": "O5",
      "claim": "Retained XDF names0xDC68 D5080 Base Desired1->2 Shift Time, reports marker-differential verification, and names signed BE16 data0xE24A D5100 Desired1->2 Shift Time Throttle Adjust. Native exported help independently describes D5080 as the desired normal1->2 shift-completion time for adaptive learning, modified by D5100. The marker experiment itself was not rerun in this bounded corroboration.",
      "provenance": [
        "retained_xdf",
        "native_help"
      ]
    },
    {
      "id": "O6",
      "claim": "At0xB55D8..0xB55FE, state0 waits on A5+0x2E16; once zero it sets detailed state A5+0x2D1C=4 and broad state A5+0x2D1D=1. This is the same detailed-state entry marker used by the desired-time consumer.",
      "windows": [
        "state0_to_state1"
      ]
    }
  ],
  "derivation": {
    "claim": "A5+0x2D1D==1 is an intermediate shift-control state that runs the named desired-shift-time family. This supports labeling the alternate RPM selector as applying in intermediate shift state1, rather than assigning an unrelated mode name.",
