  "observations": [
    {
      "classification": "observation",
      "finding": "A second Scan producer at BB497C emits optional8603 and six-byte8604. It is distinct from the VM callback BB0A14.",
      "evidence": [
        "poll_setup_arguments_and_signed_division",
        "poll_setup_interval_bytes_and_8603",
        "poll_setup_mode_flags_and_8604"
      ]
    },
    {
      "classification": "derived",
      "finding": "BB497C argument2 is signed Int32. When positive, it splits by1000 into quotient and remainder, narrows both to UInt16 and sends8603. Unlike BB0A14, it has no quotient range guard in the straight-line construction.",
      "evidence": [
        "poll_setup_arguments_and_signed_division",
        "poll_setup_interval_bytes_and_8603"
      ]
    },
    {
      "classification": "derived",
      "finding": "BB497C always constructs8604 as BYTE(arg1), BYTE(arg3), LE32(arg4); its host call argument4 is1500. BB0A14 instead selects1000 or2000 for that host parameter. These are host-call differences, not evidence of baud rate.",
      "evidence": [
        "poll_setup_mode_flags_and_8604",
        "AUTOCAL_SETUP_CALLBACK_STATIC.json:setup_fourth_argument_dword_and_8604_call"
      ]
    },
    {
      "classification": "derived",
      "finding": "Callsites12A883F and12AF7BD pass (1, TProperties.Logging_PollTime, 0, 0). The class is loaded throughBBDD18 at14A7584, constructed byBC3744 and stored through1551F2C. Its named property and setter both identify field1E8.",
      "evidence": [
        "conditional_poll_or_mode6_caller",
        "poll_start_caller",
        "properties_constructor_and_global_binding",
        "logging_poll_time_property",
        "logging_poll_time_setter"
      ]
    },
    {
      "classification": "observation",
      "finding": "Other direct calls pass (6,0,0,0) at12A884E and12ACB0D, and (0,0,0,0) at12ACB00. ED8501 calls the VM callbackBB0A14 with all zeros after the caller observes its+DD byte and stores status0508.",
