<Project>
  <!-- Resolve both NuGet and compiler ownership before SDK props consume them. -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../LocalOnly/AL5CalibrationInspectionTest/obj/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>../../LocalOnly/AL5CalibrationInspectionTest/bin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="CalibrationInspectionTest.cs" />
    <Compile Include="ProgrammingWorkflowTest.cs" />
    <Compile Include="OfflineProgrammingSessionTest.cs" />
    <Compile Include="LoaderModelReplyTest.cs" />
    <Compile Include="OfflineCoordinatorBridge.cs" />
    <Compile Include="../../Apps/PcmLibrary/AL5CalibrationInspection.cs" Link="AL5CalibrationInspection.cs" />
    <Compile Include="../../Apps/PcmLibrary/AL5ProgrammingWorkflow.cs" Link="AL5ProgrammingWorkflow.cs" />
    <Compile Include="../../Apps/PcmLibrary/AL5OfflineProgrammingSession.cs" Link="AL5OfflineProgrammingSession.cs" />
    <Compile Include="../../Apps/PcmLibrary/AL5LoaderModelReply.cs" Link="AL5LoaderModelReply.cs" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
